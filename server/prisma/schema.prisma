datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  role          String    @default("user") // "user" | "admin"
  avatar_url    String?
  bio           String?
  is_disabled   Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  trips         Trip[]

  @@map("users")
}

model City {
  id          String       @id @default(uuid())
  name        String
  country     String
  region      String       // "Europe", "Asia", "Americas", "Africa", "Oceania", "Middle East"
  image_url   String
  description String
  currency    String       @default("USD")
  timezone    String       @default("UTC")
  lat         Float?
  lng         Float?
  activities  Activity[]
  trip_stops  TripStop[]

  @@map("cities")
}

model Activity {
  id                     String          @id @default(uuid())
  city_id                String
  city                   City            @relation(fields: [city_id], references: [id], onDelete: Cascade)
  title                  String
  description            String
  category               String          // "Sightseeing", "Food & Dining", "Adventure", "Culture & History", "Relaxation"
  estimated_cost         Float           @default(0)
  estimated_duration_min Int             @default(60)
  image_url              String
  location_name          String
  rating                 Float           @default(4.8)
  trip_activities        TripActivity[]

  @@map("activities")
}

model Trip {
  id              String        @id @default(uuid())
  user_id         String
  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title           String
  description     String?
  start_date      String?       // "YYYY-MM-DD"
  end_date        String?       // "YYYY-MM-DD"
  cover_image_url String?
  is_public       Boolean       @default(false)
  public_slug     String        @unique
  target_budget   Float         @default(0)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  stops           TripStop[]
  budget_entries  BudgetEntry[]

  @@map("trips")
}

model TripStop {
  id               String          @id @default(uuid())
  trip_id          String
  trip             Trip            @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  city_id          String
  city             City            @relation(fields: [city_id], references: [id], onDelete: Cascade)
  stop_order       Int             @default(0)
  arrival_date     String?         // "YYYY-MM-DD"
  departure_date   String?         // "YYYY-MM-DD"
  notes            String?
  budget_allocated Float           @default(0)
  trip_activities  TripActivity[]

  @@map("trip_stops")
}

model TripActivity {
  id             String    @id @default(uuid())
  trip_stop_id   String
  trip_stop      TripStop  @relation(fields: [trip_stop_id], references: [id], onDelete: Cascade)
  activity_id    String?
  activity       Activity? @relation(fields: [activity_id], references: [id], onDelete: SetNull)
  custom_title   String?
  custom_cost    Float     @default(0)
  scheduled_date String?   // "YYYY-MM-DD"
  scheduled_time String?   // e.g. "10:00" or "14:30"
  notes          String?
  status         String    @default("planned") // "planned", "booked", "completed"

  @@map("trip_activities")
}

model BudgetEntry {
  id           String   @id @default(uuid())
  trip_id      String
  trip         Trip     @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  category     String   // "Flights & Transport", "Accommodation", "Activities", "Food & Dining", "Other"
  description  String
  amount       Float    @default(0)
  date         String?  // "YYYY-MM-DD"
  expense_type String   @default("actual") // "planned", "actual"

  @@map("budget_entries")
}
